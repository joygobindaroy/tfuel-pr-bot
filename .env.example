# Telegram
BOT_TOKEN=123456:ABC...
WEBHOOK_SECRET=any-long-random-string
ADMIN_IDS=111111111,222222222

# Public URL of your Vercel deployment (no trailing slash)
APP_URL=https://your-app.vercel.app

# Firebase service account (Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# IP / VPN check (https://www.ipqualityscore.com)
IPQS_API_KEY=

# Random string used to hash IPs and device ids
HASH_SALT=another-long-random-string

# Optional: chat id for admin alerts (defaults to ADMIN_IDS)
ADMIN_ALERT_CHAT_ID=

# Secret for the cron/worker route (Vercel sends it automatically as Bearer)
CRON_SECRET=another-long-random-string

# Optional but recommended: Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Binance Pay merchant credentials (USDT deposits)
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
NEXT_PUBLIC_PRIVACY_URL=

# Encrypts mirror-bot tokens stored in Firestore. Generate once, never change it.
BOT_ENC_KEY=another-long-random-string
